<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="streamUrl" type="string" onChange="onStreamUrlChange" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Video
            id="videoPlayer"
            width="1920"
            height="1080"
            translation="[0, 0]"
            enableUI="true"
        />

        <Label
            id="statusLabel"
            text="Waiting for stream URL from Android..."
            width="1920"
            height="1080"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            font="font:LargeBoldSystemFont"
        />
    </children>
</component>